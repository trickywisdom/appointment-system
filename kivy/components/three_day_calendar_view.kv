#:kivy 2.3.1
# kivy/components/three_day_calendar_view.kv


#:import dp kivy.metrics.dp
#:import get_color_from_hex kivy.utils.get_color_from_hex

<ThreeDayCalendarView>:
    # Defined in Python
    # This KV is primarily for styling/base layout if needed,
    # but the content is built dynamically in Python.
    # The outer BoxLayout properties are already set in dashboard.kv
    # This file could also define shared styles for AppointmentSlot if needed.

<AppointmentSlot>:
    # Defined in Python
    # This KV overrides or complements the Python class
    # The canvas definition is moved here for clarity
    background_normal: ''
    background_down: '' # No visual change on press, handled by background_color_rgba
    canvas.before:
        Color:
            rgba: self.background_color_rgba
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: [dp(5),]
    Label:
        text: root.display_text
        font_size: '14sp'
        color: 0,0,0,1
        halign: 'left'
        valign: 'top' # Align text to top of the slot
        padding: dp(5), dp(5) # Add some padding
        text_size: self.width - dp(10), None # Account for padding
        shorten: True # Shorten text with ellipsis if it overflows
        shorten_from: 'right'