#:kivy 2.3.1
# kivy/screens/reminders.kv

# Define how each appointment item in the RecycleView will look
<ReminderListItem>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(60) # Height for each appointment row
    padding: dp(5)
    spacing: dp(5)
    canvas.before:
        Color:
            # Alternating row colors (Light Cyan / Light Yellow)
            # Gray when pressed/selected
            rgba: (0.88, 1, 1, 1) if root.row_index % 2 == 0 and root.state == 'normal' else (1, 0.98, 0.8, 1) if root.row_index % 2 != 0 and root.state == 'normal' else (0.7, 0.7, 0.7, 1) # Gray on press
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: [dp(5),]

    # Column 1: Time Slot (Ωριαίο Διάστημα)
    Label:
        text: root.time_slot
        font_size: '15sp'
        halign: 'left'
        valign: 'middle'
        text_size: self.width, self.height
        size_hint_x: 0.3
        color: 0, 0, 0, 1 # Black text

    # Column 2: Customer Name (Ονοματεπώνυμο Πελάτη)
    Label:
        text: root.customer_name
        font_size: '15sp'
        halign: 'left'
        valign: 'middle'
        text_size: self.width, self.height
        size_hint_x: 0.4
        color: 0, 0, 0, 1 # Black text

    # Column 3: Service Name (Υπηρεσία)
    Label:
        text: root.service_name
        font_size: '15sp'
        halign: 'left'
        valign: 'middle'
        text_size: self.width, self.height
        size_hint_x: 0.3
        color: 0, 0, 0, 1 # Black text


<RemindersScreen>:
    appointment_list_rv: appointment_list_rv_id
    rv_data: root.rv_data
    selected_date_input: selected_date_input_id # Link to the TextInput

    BoxLayout:
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(10)
        canvas.before:
            Color:
                rgba: 1, 1, 1, 1 # White background for the entire screen
            Rectangle:
                size: self.size
                pos: self.pos

        # Header Section
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: dp(10)
            Label:
                text: "Ραντεβού Ημέρας" # Changed title
                font_size: '24sp'
                color: 0.12, 0.25, 0.44, 1
                halign: 'left'
                valign: 'middle'
                text_size: self.size

        # Date Picker Section
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            spacing: dp(10)
            Label:
                text: "Ημερομηνία:"
                size_hint_x: 0.2
                font_size: '18sp'
                color: 0,0,0,1
                halign: 'left'
                valign: 'middle'
            TextInput:
                id: selected_date_input_id
                text: app.format_date(root.current_date) # Display current date
                font_size: '18sp'
                size_hint_x: 0.6
                multiline: False
                readonly: True # User can't type, must use picker
                on_touch_down:
                    if self.collide_point(*args[1].pos): root.open_date_picker()
                background_normal: ''
                background_active: ''
                background_color: 1, 1, 1, 1
                foreground_color: 0, 0, 0, 1
                cursor_color: 0, 0, 0, 1
                padding: [dp(10), dp(10), dp(10), dp(10)]
            Button:
                text: "Επιλογή"
                size_hint_x: 0.2
                on_release: root.open_date_picker()
                background_normal: ''
                background_color: 0.03, 0.37, 0.71, 1
                color: 1, 1, 1, 1

        # Appointment List - RecycleView
        RecycleView:
            id: appointment_list_rv_id
            viewclass: 'ReminderListItem' # Still using ReminderListItem as viewclass
            data: root.rv_data
            do_scroll_y: True
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1 # White background for RecycleView
                Rectangle:
                    size: self.size
                    pos: self.pos

            RecycleBoxLayout:
                default_size: None, dp(60) # Match ReminderListItem height
                default_size_hint: 1, None
                orientation: 'vertical'
                spacing: dp(5)
                padding: dp(5)
                size_hint_y: None
                height: self.minimum_height
                canvas.before:
                    Color:
                        rgba: 1, 1, 1, 1 # White background for RecycleBoxLayout
                    Rectangle:
                        size: self.size
                        pos: self.pos

        # Footer Buttons (Email and Excel)
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(60)
            padding: dp(10), dp(0)
            spacing: dp(10)
            halign: 'center'
            valign: 'center'

            Button:
                text: "Αποστολή Email"
                size_hint_x: 0.5
                background_normal: ''
                background_color: 0.03, 0.37, 0.71, 1 # Blue
                color: 1, 1, 1, 1
                on_release: root.send_email_reminders()
            Button:
                text: "Εκτύπωση σε Excel"
                size_hint_x: 0.5
                background_normal: ''
                background_color: 0.2, 0.6, 0.2, 1 # Green
                color: 1, 1, 1, 1
                on_release: root.export_to_excel()

        Button: # Back button
            text: "Επιστροφή"
            size_hint_y: None
            height: dp(48)
            background_normal: ''
            background_color: 0.8, 0.8, 0.8, 1
            color: 0, 0, 0, 1
            on_release: root.go_back()