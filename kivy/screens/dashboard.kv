#:kivy 2.3.1
# kivy/screens/dashboard.kv

# Kivy Core Imports
#:import Clock kivy.clock.Clock
#:import datetime datetime.datetime
#:import date datetime.date
#:import timedelta datetime.timedelta
#:import get_color_from_hex kivy.utils.get_color_from_hex
#:import ScreenManager kivy.uix.screenmanager
#:import Screen kivy.uix.screenmanager
#:import dp kivy.metrics.dp
#:import Animation kivy.animation.Animation
#:import Widget kivy.uix.widget.Widget

# KivyMD Widget Imports
#:import MDTopAppBar kivymd.uix.appbar.MDTopAppBar
#:import MDLabel kivymd.uix.label.label.MDLabel
#:import MDButton kivymd.uix.button.button.MDButton
#:import MDButtonText kivymd.uix.button.button.MDButtonText
#:import MDIconButton kivymd.uix.button.button.MDIconButton
#:import MDNavigationLayout kivymd.uix.navigationdrawer.MDNavigationLayout
#:import MDNavigationDrawer kivymd.uix.navigationdrawer.MDNavigationDrawer
#:import MDScreen kivymd.uix.screen.MDScreen
#:import BoxLayout kivy.uix.boxlayout.BoxLayout
#:import FloatLayout kivy.uix.floatlayout.FloatLayout 
#:import MDTopAppBarLeadingButtonContainer kivymd.uix.appbar.MDTopAppBarLeadingButtonContainer
#:import MDTopAppBarTitle kivymd.uix.appbar.MDTopAppBarTitle
#:import MDTopAppBarTrailingButtonContainer kivymd.uix.appbar.MDTopAppBarTrailingButtonContainer
#:import MDActionTopAppBarButton kivymd.uix.appbar.MDActionTopAppBarButton


<FABMenu>:
    size_hint: None, None
    width: dp(56)
    height: dp(56)
    opacity: 0
    disabled: True

    MDIconButton:
        id: main_fab
        icon: "plus"
        pos: root.width - self.width, 0
        style: "standard"
        on_release: root.toggle_menu()

    MDBoxLayout:
        id: menu_items_container
        orientation: 'vertical'
        size_hint_y: None
        height: self.minimum_height
        spacing: dp(10)
        padding: dp(10)
        x: root.width - self.width
        y: root.height - self.height - dp(10)
        canvas.before:
            Color:
                rgba: 0.95, 0.95, 0.95, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(10)]

        MDButton:
            style: "elevated"
            on_release: app.root.get_screen('dashboard_screen').add_appointment_from_fab(); root.toggle_menu()
            MDButtonText:
                text: "Νέο Ραντεβού"
                size_hint_y: None
                height: dp(48)
        
        MDButton:
            style: "elevated"
            on_release: app.root.get_screen('dashboard_screen').add_client_from_fab(); root.toggle_menu()
            MDButtonText:
                text: "Νέος Πελάτης"
                size_hint_y: None
                height: dp(48)

<DashboardScreen>:
    name: 'dashboard_screen'
    month_display_label: month_label_id

    BoxLayout:
        id: main_content
        orientation: 'vertical'

        MDNavigationLayout:
            id: nav_layout

            ScreenManager:
                id: screen_manager

                Screen:
                    name: 'main_dashboard_content'

                    BoxLayout:
                        orientation: 'vertical'

                        MDTopAppBar:
                            id: top_app_bar_id
                            type: "small"
                            size_hint_x: 1
                            # pos_hint: {"center_x": .5, "center_y": .5}
                            # size_hint_y: None
                            # height: dp(56)  # Προσαρμογή εδώ
                            pos_hint: {"top": 1}
                            # elevation: 0
                            # specific_text_color: [1, 1, 1, 1]
                            # theme_bg_color: "Custom"
                            # md_bg_color: [0.2, 0.4, 0.8, 1]

                            MDTopAppBarLeadingButtonContainer:

                                MDActionTopAppBarButton:
                                    icon: "menu"
                                    # on_release: nav_layout.toggle_nav_drawer()
                                    # on_release: nav_drawer.set_state("toggle")
                                    on_release: root.open_nav_drawer()

                            MDTopAppBarTitle:
                                id: month_label_id
                                text: root.current_display_date.strftime("%B").capitalize()
                                halign: "center"
                                # font_style: "Title"
                                # role: "small"
                                theme_font_name: "Custom"
                                font_name: "dejaVuSans"

                            MDTopAppBarTrailingButtonContainer:

                                MDActionTopAppBarButton:
                                    icon: "calendar-month"
                                    on_release: root.open_month_picker()
                                      
                                MDActionTopAppBarButton:
                                    icon: "magnify"
                                    on_release: root.open_search_modal()

                        # --- Main Content Area: 3-Day View ---
                        ThreeDayCalendarView:
                            id: three_day_view
                            size_hint_y: 1
                            on_kv_post:
                                self.app = app
                                self.dashboard_screen = root 

                        # --- Floating Action Button (FAB) Container ---
                        FloatLayout:
                            size_hint_y: None
                            height: dp(80)

                            FABMenu:
                                id: fab_menu
                                pos: self.parent.width - self.width - dp(20), dp(20)

            # Navigation Drawer
            MDNavigationDrawer:
                id: nav_drawer
                radius: (0, 16, 16, 0) if self.anchor == "left" else (16, 0, 0, 16)
                # on_state: root.on_drawer_state_change(self.state)
                # on_open: root.animate_drawer_content()
                drawer_type: "modal"  # Εξασφαλίζει ότι είναι modal
                close_on_click: True  # Κλείνει όταν πατάς στο scrim
                scrim_color: 0, 0, 0, 0.5  # Ημιδιαφανές scrim
                on_state: root.on_drawer_state_change(self.state)

                MDNavigationDrawerMenu:
                    id: nav_drawer_content_box
                    # adaptive_height: True
                    # padding: dp(20)
                    # spacing: dp(15)
                    # size_hint_y: None
                    # size_hint_y: 0.8
                    # height: dp(800)

                    MDLabel:
                        text: "Μενού"
                        font_style: "Title"
                        role: "large"
                        halign: "center"
                        size_hint_y: None
                        height: dp(50)
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primaryColor

                    MDButton:
                        id: new_appointment_btn
                        style: "text"
                        size_hint_y: None
                        height: dp(50)
                        on_release: root.change_screen_and_dismiss_drawer('new_appointment_screen')      
                        MDButtonIcon:
                            icon: ""        
                        MDButtonText:
                            text: "Νέο Ραντεβού"
                            theme_text_color: "Custom"
                            text_color: "000000"
                            theme_font_name: "Custom"
                            font_name: "dejaVuSans"
                            pos_hint: {"center_x": .5, "center_y": .5}

                    MDButton:
                        id: new_client_btn
                        # size_hint_x: .5
                        style: "text"
                        size_hint_y: None
                        height: dp(50)
                        # on_release: root.change_screen_and_dismiss_drawer('new_client_screen')
                        # on_release: root.printme()
                        on_release: root.change_screen_and_dismiss_drawer('new_appointment_screen')      
                        MDButtonIcon:
                            icon: ""        
                        MDButtonText:
                            text: "Νέος Πελάτης"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.onSurfaceColor
                            theme_font_name: "Custom"
                            font_name: "dejaVuSans"
                            pos_hint: {"center_x": .5, "center_y": .5}

                    MDButton:
                        id: clients_list_btn
                        style: "text"
                        size_hint_y: None
                        height: dp(50)
                        on_release: root.change_screen_and_dismiss_drawer('clients_screen')      
                        MDButtonIcon:
                            icon: ""        
                        MDButtonText:
                            text: "Λίστα Πελατών"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.onSurfaceColor
                            theme_font_name: "Custom"
                            font_name: "dejaVuSans"
                            pos_hint: {"center_x": .5, "center_y": .5}

                    MDButton:
                        id: daily_appointments_btn
                        style: "text"
                        size_hint_y: None
                        height: dp(50)
                        on_release: root.change_screen_and_dismiss_drawer('reminders_screen')    
                        MDButtonIcon:
                            icon: ""        
                        MDButtonText:
                            text: "Ραντεβού Ημέρας / Email / Print"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.onSurfaceColor
                            theme_font_name: "Custom"
                            font_name: "dejaVuSans"
                            pos_hint: {"center_x": .5, "center_y": .5}
                
                    # MDBoxLayout:
                    #     id: nav_drawer_content_box
                    #     orientation: 'vertical'
                    #     padding: dp(20)
                    #     spacing: dp(15)
                    #     canvas.before:
                    #         Color:
                    #             rgba: 0.98, 0.98, 0.98, 1
                    #         Rectangle:
                    #             pos: self.pos
                    #             size: self.size

                    MDButton:
                        id: reports_btn
                        style: "text"
                        size_hint_y: None
                        height: dp(50)
                        on_release: root.show_popup("Αναφορές", "Αυτή η λειτουργία δεν είναι διαθέσιμη ακόμα.")   
                        MDButtonIcon:
                            icon: ""        
                        MDButtonText:
                            text: "Αναφορές"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.onSurfaceColor
                            theme_font_name: "Custom"
                            font_name: "dejaVuSans"
                            pos_hint: {"center_x": .5, "center_y": .5}

                    MDButton:
                        id: settings_btn
                        style: "text"
                        size_hint_y: None
                        height: dp(50)
                        on_release: root.show_popup("Ρυθμίσεις", "Αυτή η λειτουργία δεν είναι διαθέσιμη ακόμα.")   
                        MDButtonIcon:
                            icon: ""        
                        MDButtonText:
                            text: "Ρυθμίσεις"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.onSurfaceColor
                            theme_font_name: "Custom"
                            font_name: "dejaVuSans"
                            pos_hint: {"center_x": .5, "center_y": .5}
                            
                    # Widget:
                    #     size_hint_y: 1